# Copy to .env before running.

# Postgres (Docker Compose — PRD §11.1). These three values also seed the
# `postgres` service's own environment in docker-compose.yml.
POSTGRES_USER="nexus"
POSTGRES_PASSWORD="nexus_dev_password"
POSTGRES_DB="nexus_crm_lite"

# Used by Prisma when running on the host (npm run dev, prisma migrate dev).
# Inside docker-compose, the "web" service overrides this to point at the
# "postgres" service hostname instead of localhost — see docker-compose.yml.
DATABASE_URL="postgresql://nexus:nexus_dev_password@localhost:5432/nexus_crm_lite"

# NextAuth — generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Points the CRM at the FastAPI inference service (PRD §5.2/§7.3).
# If unset or unreachable, lib/ai-client.ts falls back to a degraded local
# heuristic — see docs/ARCHITECTURE.md for why that fallback does not by
# itself satisfy FR-AI-01/FR-AI-02.
ML_SERVICE_URL="http://localhost:8001"

# Optional, FR-AI-04 (P2 stretch) — not implemented in this pass.
# LLM_API_KEY=""
